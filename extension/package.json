{
  "name": "doubao-download",
  "version": "1.0.0",
  "private": true,
  "description": "豆包下载 — 一键 ZIP 打包对话高清图",
  "scripts": {
    "sync:console": "node -e \"require('fs').copyFileSync('../scripts/doubao-console-batch-download.js','public/doubao-console-batch-download.js')\"",
    "dev": "npm run sync:console && wxt",
    "build": "npm run sync:console && wxt build",
    "zip": "npm run sync:console && wxt zip",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "typescript": "^5.9.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  }
}
